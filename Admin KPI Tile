    & "</tspan></text><text x='350' y='872' text-anchor='middle' fill='#FFFFFF' font-size='21' font-weight='600'>Admin Assist</text><text x='350' y='900' text-anchor='middle' fill='#FFFFFF' font-size='21' font-weight='600'>Adoption Rate</text><circle cx='700' cy='708' r='112' fill='none' stroke='#70B8D0' stroke-opacity='0.85' stroke-width='16'/><circle cx='700' cy='708' r='112' fill='none' stroke='#00F0F8' stroke-opacity='0.14' stroke-width='30' stroke-linecap='round' stroke-dasharray='"
