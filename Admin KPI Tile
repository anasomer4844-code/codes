    & SUBSTITUTE ( FORMAT ( _Circ * MIN ( 1, MAX ( 0, _StorageReduction ) ), "0.00" ), ",", "." )
    & " 703.72' transform='rotate(-90 175 318)'/><circle cx='175' cy='318' r='112' fill='none' stroke='url(#kpiG)' stroke-width='16' stroke-linecap='round' stroke-dasharray='"
