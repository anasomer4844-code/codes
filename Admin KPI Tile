    & " 703.72' transform='rotate(-90 175 318)'/><text x='175' y='338' text-anchor='middle' fill='#FFFFFF' font-size='56' font-weight='700'>"
    & SUBSTITUTE ( FORMAT ( _StorageReduction * 100, "0.00" ), ",", "." )
    & "<tspan fill='#70B8D0' font-size='28' font-weight='600'>"
    & "%"
    & "</tspan></text><text x='175' y='482' text-anchor='middle' fill='#FFFFFF' font-size='21' font-weight='600'>Reduction in Physical</text><text x='175' y='510' text-anchor='middle' fill='#FFFFFF' font-size='21' font-weight='600'>Documents Storage Space</text><circle cx='525' cy='318' r='112' fill='none' stroke='#70B8D0' stroke-opacity='0.85' stroke-width='16'/><circle cx='525' cy='318' r='112' fill='none' stroke='#00F0F8' stroke-opacity='0.14' stroke-width='30' stroke-linecap='round' stroke-dasharray='"
