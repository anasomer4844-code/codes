    & SUBSTITUTE ( FORMAT ( _Circ * MIN ( 1, MAX ( 0, DIVIDE ( _EventSurveyScore, _EventSurveyMax ) ) ), "0.00" ), ",", "." )
    & " 703.72' transform='rotate(-90 875 318)'/><text x='875' y='338' text-anchor='middle' fill='#FFFFFF' font-size='56' font-weight='700'>"
    & SUBSTITUTE ( FORMAT ( _EventSurveyScore, "0.0" ), ",", "." )
