    & " 703.72' transform='rotate(-90 1225 318)'/><text x='1225' y='338' text-anchor='middle' fill='#FFFFFF' font-size='56' font-weight='700'>"
    & SUBSTITUTE ( FORMAT ( _HospitalityRating, "0.0" ), ",", "." )
