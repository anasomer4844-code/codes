--  ADMINISTRATION KPI TILE  |  HTML Content visual  |  1400 x 960 (35:24)
--  Edit the shared Admin measures above; both dashboard tiles use them.
-- ======================================================================
VAR _Title                = "Admin - Other Relevant KPIs"

VAR _StorageReduction     = [Admin Storage Reduction]
VAR _EventsDelivered      = [Admin Events Delivered]
VAR _EventsTarget         = [Admin Events Target]
VAR _EventSurveyScore     = [Admin Event Survey Score]
VAR _EventSurveyMax       = 5
VAR _HospitalityRating    = [Admin Hospitality Rating]
VAR _HospitalityMax       = 10
VAR _AdminAssistAdoption  = [Admin Assist Adoption]
VAR _ESGOnTimeSubmission  = [Admin ESG On Time Submission]
VAR _DiversionRate        = [Admin Sustainability Diversion]

-- ---------------------------- rendering -------------------------------
VAR _Circ = 703.7168   -- ring circumference (2 * PI * 112)
RETURN
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1400 960' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='Segoe UI, Arial, sans-serif' style='background:#111111;display:block'><defs><linearGradient id='kpiG' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#00F0F8'/><stop offset='1' stop-color='#00B0C0'/></linearGradient></defs><rect width='1400' height='960' fill='#111111'/><text x='700' y='96' text-anchor='middle' fill='#FFFFFF' font-size='40' font-weight='700' letter-spacing='0.5'>"
    & _Title
